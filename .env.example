# Пример конфигурации WBM.
# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env

# Таймаут HTTP-запроса в секундах.
WBM_TIMEOUT=5

# Интервал между проверками в секундах.
# Если закомментирован — программа делает одну проверку и выходит.
# Для разработки удобно 10, для продакшена — 60 и больше.
# WBM_INTERVAL=60

# Токен бота от @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# ID чата для уведомлений.
# Узнать: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Пароль для PostgreSQL. Придумай свой.
WBM_DB_PASSWORD=